---
import Page from '../layouts/Page.astro';

import { href } from '../site';
---

<Page
  title="Page not found — HomeMind"
  description="That address is not part of the HomeMind site. Go back to the HomeMind page, or find help on the support page."
>
  <main id="main" class="lost">
    <div class="shell stack">
      <p class="t-overline">404</p>
      <h1 class="t-display">This page doesn’t exist.</h1>
      <p class="t-lead measure">
        The link may be old or mistyped. Everything on the site is reachable from the home page.
      </p>
      <p class="actions">
        <a class="button button--primary" href={href('')}>Back to the HomeMind page</a>
        <a class="button" href={href('support/')}>Get help</a>
      </p>
    </div>
  </main>
</Page>

<style>
  .lost {
    padding-block: clamp(56px, 14vw, 128px);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hm-space-component);
  }
</style>
