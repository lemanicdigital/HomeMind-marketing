---
import Page from '../layouts/Page.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
---

<Page
  title="Page not found — HomeMind"
  description="That address is not part of the HomeMind site. The site is a landing page and a privacy policy, written as the product is built."
>
  <main id="main" class="lost">
    <div class="shell stack">
      <p class="t-overline">404</p>
      <h1 class="t-display">There is nothing at this address yet.</h1>
      <p class="t-lead measure">
        HomeMind’s site is deliberately small: one page describing a product that is still in private
        development, a privacy policy, and no deep links to invent. If something pointed you here, the
        link was wrong.
      </p>
      <p><a class="button button--primary" href={home}>Back to the HomeMind page</a></p>
    </div>
  </main>
</Page>

<style>
  .lost {
    padding-block: clamp(56px, 14vw, 128px);
  }
</style>
