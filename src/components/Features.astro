---
/** Six things HomeMind does, each with a line icon drawn in the page's own stroke style. */
const features = [
  {
    title: 'Everything in one place',
    body: 'What you have, how much and where it lives: the fridge, the cupboard, the shelf by the washing machine.',
    icon: 'M4 7.5 12 3.5l8 4v9l-8 4-8-4Z M4 7.5l8 4 8-4 M12 11.5v9',
  },
  {
    title: 'Use it before it goes off',
    body: 'Expiry dates turn into “use today” and “3 days left”, and one calm morning note lists what needs eating.',
    icon: 'M6.5 16v-5a5.5 5.5 0 0 1 11 0v5l1.5 2h-14Z M10 20.5h4',
  },
  {
    title: 'A list that writes itself',
    body: 'Run out and it lands on the shopping list. Running low and it is suggested, with the reason beside it.',
    icon: 'M3 4h2.2l2.3 10.5h10.8L20.5 7.5H6.2 M9.5 19.5h.01 M17 19.5h.01',
  },
  {
    title: 'Scan instead of typing',
    body: 'Point the camera at a barcode and the product name fills itself in. Typing always works too.',
    icon: 'M4 7V5h3 M17 5h3v2 M20 17v2h-3 M7 19H4v-2 M8 9v6 M11 9v6 M14 9v6 M16.5 9v6',
  },
  {
    title: 'One household, every phone',
    body: 'Invite the people you live with. Everyone sees the same stock and the same list, kept in sync.',
    icon: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z M2.5 20a6.5 6.5 0 0 1 13 0 M16 4.6a3.5 3.5 0 0 1 0 6.3 M18 14.4a6 6 0 0 1 3.5 5.6',
  },
  {
    title: 'Works without a signal',
    body: 'Your phone keeps the working copy, so the basement shop is no problem. Changes sync when you are back.',
    icon: 'M8 3h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z M11 18h2',
  },
];
---

<section class="section" id="features" aria-labelledby="features-title">
  <div class="shell">
    <header class="section__head section__head--center">
      <p class="t-overline">Features</p>
      <h2 class="t-headline" id="features-title">The small arithmetic of a household, done for you</h2>
      <p class="t-lead">
        Stop buying a fourth jar of something you already have three of, and finding the fourth one
        the week after it expired.
      </p>
    </header>

    <ul class="features" role="list">
      {
        features.map((feature) => (
          <li class="feature">
            <span class="feature__icon">
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
                <path d={feature.icon} />
              </svg>
            </span>
            <h3 class="t-card-title">{feature.title}</h3>
            <p class="t-secondary">{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    display: grid;
    gap: var(--hm-space-screen-gutter);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .feature {
    display: grid;
    gap: var(--hm-space-inline);
    align-content: start;
    padding: var(--hm-space-section) var(--hm-space-card);
    border: var(--hm-border-hairline) solid var(--hm-border-subtle);
    border-radius: var(--hm-radius-sheet);
    background: var(--hm-surface);
  }

  .feature__icon {
    display: grid;
    place-items: center;
    inline-size: 48px;
    block-size: 48px;
    margin-bottom: var(--hm-space-inline);
    border-radius: var(--hm-radius-card);
    background: var(--hm-primary-subtle);
  }

  .feature__icon svg {
    fill: none;
    stroke: var(--hm-on-primary-subtle);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
