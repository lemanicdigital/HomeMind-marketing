---
import { type Lang, copyFor } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = copyFor(lang).features;
/**
 * Six things HomeMind does, set as a list in large type beside the section's heading: the words
 * carry it, with no icon cards. On a desk the heading stays in view while the list scrolls past.
 */
---

<section class="section" id="features" aria-labelledby="features-title">
  <div class="shell features">
    <h2 class="t-headline features__title-main" id="features-title">{c.title}</h2>
    <p class="t-lead features__lead">{c.lead}</p>

    <ul class="features__list" role="list">
      {
        c.items.map((feature) => (
          <li>
            <h3 class="features__title">{feature.title}</h3>
            <p class="t-secondary">{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    display: grid;
    gap: clamp(40px, 6vw, 72px) clamp(40px, 8vw, 120px);
  }

  @media (min-width: 60rem) {
    .features {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .features__title-main {
      grid-column: 1 / -1;
    }

    .features__lead {
      position: sticky;
      top: 120px;
    }
  }

  .features__list {
    display: grid;
    gap: clamp(32px, 4vw, 48px);
  }

  .features__list li {
    display: grid;
    gap: var(--hm-space-inline);
    max-width: 34rem;
  }

  .features__title {
    font-size: var(--site-title);
    line-height: 1.3;
    font-weight: var(--hm-type-title-weight);
    letter-spacing: -0.01em;
  }
</style>
