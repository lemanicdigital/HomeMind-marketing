---
import Logo from './ui/Logo.astro';
import { href } from '../site';

const links = [
  // Every link names the home page: this header is on /privacy/ and /support/ too.
  { href: href('#features'), label: 'Features' },
  { href: href('#app'), label: 'Screens' },
  { href: href('#privacy'), label: 'Privacy' },
  { href: href('#faq'), label: 'FAQ' },
  { href: href('support/'), label: 'Support' },
];
---

<header class="bar">
  <div class="shell bar__inner">
    <a class="brand" href={href('')} aria-label="HomeMind home page">
      <Logo size={28} />
      <span class="brand__name">HomeMind</span>
    </a>
    <nav class="bar__nav" aria-label="Sections of this page">
      <ul class="nav">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="bar__cta" href={href('#launch')}>Coming soon</a>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--hm-header-background);
    border-bottom: var(--hm-border-hairline) solid var(--hm-border-subtle);
  }

  .bar__inner {
    display: flex;
    align-items: center;
    gap: var(--hm-space-card);
    min-block-size: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--hm-space-inline);
    color: var(--hm-text-primary);
    text-decoration: none;
  }

  .brand__name {
    font-size: var(--hm-type-section-title-size);
    font-weight: var(--hm-type-title-weight);
    letter-spacing: -0.02em;
  }

  .bar__nav {
    margin-inline-start: auto;
  }

  .nav {
    display: flex;
    gap: var(--hm-space-micro);
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--hm-touch-target);
    padding-inline: var(--hm-space-component);
    border-radius: var(--hm-radius-pill);
    color: var(--hm-text-secondary);
    font-size: var(--hm-type-label-size);
    font-weight: var(--hm-type-label-weight);
    text-decoration: none;
  }

  .nav a:hover {
    background: var(--hm-surface-secondary);
    color: var(--hm-text-primary);
  }

  .bar__cta {
    display: inline-flex;
    align-items: center;
    min-block-size: 40px;
    padding-inline: var(--hm-space-card);
    border-radius: var(--hm-radius-pill);
    background: var(--hm-primary);
    color: var(--hm-on-primary);
    font-size: var(--hm-type-label-size);
    font-weight: var(--hm-type-label-weight);
    text-decoration: none;
  }

  .bar__cta:hover {
    background: var(--hm-primary-pressed);
  }

  /* On a phone the section links go; the page is short enough to scroll, and the bar stays calm. */
  @media (max-width: 48rem) {
    .bar__nav {
      display: none;
    }

    .bar__cta {
      margin-inline-start: auto;
    }
  }
</style>
