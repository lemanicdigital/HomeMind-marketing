---
import Logo from './ui/Logo.astro';
import { LANGS, LANG_NAMES, type Lang, copyFor, englishPage, home } from '../i18n';

interface Props {
  lang?: Lang;
  /** This page in each language; a language without its own version links to its home page. */
  alternates?: Partial<Record<Lang, string>>;
}

const { lang = 'en', alternates = {} } = Astro.props;
const c = copyFor(lang).nav;

const links = [
  // Every link names the home page: this header is on /privacy/ and /support/ too.
  { href: home(lang, '#features'), label: c.features },
  { href: home(lang, '#app'), label: c.screens },
  { href: home(lang, '#pricing'), label: c.pricing },
  { href: home(lang, '#privacy'), label: c.privacy },
  { href: home(lang, '#faq'), label: c.faq },
  { href: englishPage('support/'), label: c.support },
];

const languages = LANGS.map((code) => ({
  code,
  name: LANG_NAMES[code],
  href: alternates[code] ?? home(code),
  current: code === lang,
}));
---

<header class="bar">
  <div class="shell bar__inner">
    <a class="brand" href={home(lang)} aria-label={c.home}>
      <Logo size={28} />
      <span class="brand__name">HomeMind</span>
    </a>
    <nav class="bar__nav" aria-label={c.sections}>
      <ul class="nav">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav class="langs" aria-label={c.language}>
      <ul>
        {
          languages.map((language) => (
            <li>
              <a
                href={language.href}
                hreflang={language.code}
                lang={language.code}
                aria-current={language.current ? 'true' : undefined}
                title={language.name}
              >
                <span aria-hidden="true">{language.code.toUpperCase()}</span>
                <span class="visually-hidden">{language.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="bar__cta" href={home(lang, '#launch')}>{c.soon}</a>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--hm-header-background);
    border-bottom: var(--hm-border-hairline) solid var(--hm-border-subtle);
  }

  .bar__inner {
    display: flex;
    align-items: center;
    gap: var(--hm-space-card);
    min-block-size: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--hm-space-inline);
    color: var(--hm-text-primary);
    text-decoration: none;
  }

  .brand__name {
    font-size: var(--hm-type-section-title-size);
    font-weight: var(--hm-type-title-weight);
    letter-spacing: -0.02em;
  }

  .bar__nav {
    margin-inline-start: auto;
  }

  .nav {
    display: flex;
    gap: var(--hm-space-micro);
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--hm-touch-target);
    padding-inline: var(--hm-space-component);
    border-radius: var(--hm-radius-pill);
    color: var(--hm-text-secondary);
    font-size: var(--hm-type-label-size);
    font-weight: var(--hm-type-label-weight);
    text-decoration: none;
  }

  .nav a:hover {
    background: var(--hm-surface-secondary);
    color: var(--hm-text-primary);
  }

  /* The language switcher: four short codes, the current one filled. Stays on a phone too. */
  .langs ul {
    display: flex;
    gap: 2px;
  }

  .langs a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--hm-touch-target);
    min-inline-size: 36px;
    border-radius: var(--hm-radius-pill);
    color: var(--hm-text-secondary);
    font-size: var(--hm-type-caption-size);
    font-weight: var(--hm-type-label-weight);
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .langs a:hover {
    background: var(--hm-surface-secondary);
    color: var(--hm-text-primary);
  }

  .langs a[aria-current='true'] {
    background: var(--hm-surface-secondary);
    color: var(--hm-text-primary);
  }

  .bar__cta {
    display: inline-flex;
    align-items: center;
    min-block-size: 40px;
    padding-inline: var(--hm-space-card);
    border-radius: var(--hm-radius-pill);
    background: var(--hm-primary);
    color: var(--hm-on-primary);
    font-size: var(--hm-type-label-size);
    font-weight: var(--hm-type-label-weight);
    text-decoration: none;
  }

  .bar__cta:hover {
    background: var(--hm-primary-pressed);
  }

  /* On a phone the section links go; the page is short enough to scroll, and the bar stays calm. */
  @media (max-width: 48rem) {
    .bar__nav {
      display: none;
    }

    .langs {
      margin-inline-start: auto;
    }
  }

  /* The narrowest phones keep the languages and drop the button: the page itself says "coming soon". */
  @media (max-width: 26rem) {
    .bar__cta {
      display: none;
    }
  }
</style>
