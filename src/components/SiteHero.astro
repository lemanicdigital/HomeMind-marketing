---
import HomeScreen from './app/HomeScreen.astro';
import { type Lang, copyFor } from '../i18n';

/**
 * The first screen: what Homesky is, one action, and the live part of the page. The four times
 * are radio buttons; picking one recolours this screen and the Home screen's sky through `:has()`
 * (global.css), the way the app's own Home follows the clock. No JavaScript: the page starts at
 * 7:00 and every time is a real, keyboard-reachable control.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { hero, app } = copyFor(lang);
const skies = ['dawn', 'day', 'dusk', 'night'];
---

<section class="hero field field--sky" aria-labelledby="hero-title">
  <div class="shell grid hero__grid">
    <div class="hero__text">
      <h1 id="hero-title" class="t-display rise">{hero.title}</h1>
      <p class="t-lead hero__lead rise rise--2">{hero.lead}</p>
      <a class="button button--primary rise rise--3" href="#app">
        {hero.primary}
        <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14m-6-6 6 6 6-6"
          ></path></svg>
      </a>
    </div>

    <fieldset class="hero__times">
      <legend class="hero__legend">{hero.timeLabel}</legend>
      <div class="times">
        {
          hero.times.map((time, index) => (
            <>
              <input
                class="times__input visually-hidden"
                type="radio"
                name="sky"
                id={`sky-${skies[index]}`}
                checked={index === 0}
              />
              <label class="times__label" for={`sky-${skies[index]}`}>
                {time.label}
              </label>
            </>
          ))
        }
      </div>
      <p class="hero__captions">
        {
          hero.times.map((time, index) => (
            <span class={`hero__caption hero__caption--${skies[index]}`}>{time.caption}</span>
          ))
        }
      </p>
    </fieldset>

    <div class="hero__stage">
      <div class="hero__shutter">
        <HomeScreen app={app} times={hero.times.map((time) => time.label)} label={hero.imageAlt} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-block-size: auto;
    padding-block: clamp(40px, 7vw, 104px) 0;
  }

  .hero__grid {
    grid-template-rows: auto 1fr;
    row-gap: clamp(32px, 4vw, 56px);
  }

  .hero__text {
    grid-column: 1 / span 7;
    grid-row: 1;
    display: grid;
    justify-items: start;
    gap: 28px;
  }

  .hero__lead {
    max-inline-size: 40ch;
  }

  /* ---- the time switch: the app's segmented control, at page size ---- */

  .hero__times {
    grid-column: 1 / span 5;
    grid-row: 2;
    align-self: start;
    display: grid;
    gap: 16px;
    padding-block-end: 64px;
  }

  .hero__legend {
    float: left;
    font-size: var(--fs-small);
    font-weight: var(--hm-type-label-weight);
    margin-block-end: 12px;
  }

  .times {
    clear: both;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    padding: 4px;
    border-radius: var(--hm-radius-pill);
    background: var(--hm-surface);
  }

  .times__label {
    display: grid;
    place-items: center;
    min-block-size: 48px;
    border-radius: var(--hm-radius-pill);
    font-size: var(--fs-small);
    font-weight: var(--hm-type-label-weight);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition:
      background-color 200ms var(--ease),
      color 200ms var(--ease),
      transform 160ms var(--ease);
  }

  .times__label:hover {
    background: var(--hm-surface-secondary);
  }

  .times__label:active {
    transform: scale(0.95);
  }

  .times__input:checked + .times__label {
    background: var(--hm-primary);
    color: var(--hm-on-primary);
  }

  .times__input:focus-visible + .times__label {
    outline: 3px solid var(--hm-border-focus);
    outline-offset: 2px;
  }

  .hero__captions {
    min-block-size: 3.2em;
    max-inline-size: 36ch;
  }

  .hero__caption {
    display: none;
  }

  .hero__caption--dawn {
    display: inline;
  }

  :root:has(#sky-day:checked) .hero__caption--dawn,
  :root:has(#sky-dusk:checked) .hero__caption--dawn,
  :root:has(#sky-night:checked) .hero__caption--dawn {
    display: none;
  }

  :root:has(#sky-day:checked) .hero__caption--day,
  :root:has(#sky-dusk:checked) .hero__caption--dusk,
  :root:has(#sky-night:checked) .hero__caption--night {
    display: inline;
  }

  /* ---- the stage: blueberry, its corner cut at the slope of the icon's roof ---- */

  .hero__stage {
    grid-column: 8 / -1;
    grid-row: 1 / span 2;
    align-self: end;
    margin-inline-end: calc(-1 * var(--margin));
    margin-block-start: clamp(96px, 10vw, 160px);
    block-size: clamp(520px, 44vw, 640px);
    padding: 56px 0 0 clamp(32px, 6vw, 96px);
    background: var(--hm-primary);
    clip-path: polygon(0 150px, 180px 0, 100% 0, 100% 100%, 0 100%);
    overflow: hidden;
  }

  .hero__shutter {
    inline-size: fit-content;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__shutter {
      animation: shutter 1.1s var(--ease) 0.15s both;
    }
  }

  @keyframes shutter {
    from {
      clip-path: inset(100% 0 0 0);
      transform: translateY(60px) scale(1.06);
    }
    to {
      clip-path: inset(0);
      transform: none;
    }
  }

  @media (max-width: 960px) {
    .hero__text,
    .hero__times {
      grid-column: 1 / -1;
    }

    .hero__times {
      grid-row: auto;
      padding-block-end: 0;
      max-inline-size: 480px;
    }

    .hero__stage {
      grid-column: 1 / -1;
      grid-row: auto;
      margin-inline: calc(-1 * var(--margin));
      margin-block-start: 8px;
      block-size: 560px;
      padding: 48px 16px 0;
      clip-path: polygon(0 80px, 96px 0, 100% 0, 100% 100%, 0 100%);
    }

    .hero__shutter {
      margin-inline: auto;
    }
  }
</style>
