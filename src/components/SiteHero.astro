---
import { type Lang, copyFor } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = copyFor(lang).hero;
/**
 * What HomeMind is, in one look: the promise across the full width in display type, then the
 * supporting sentence and the actions beside the real Home screen. The two floating notes are drawn
 * in HTML from the app's own badge styles, not baked into the image.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero" id="top">
  <div class="shell hero__grid">
    <h1 class="hero__title">{c.title}</h1>

    <div class="hero__copy">
      <p class="hero__lead">{c.lead} <strong>{c.eyebrow}.</strong></p>

      <p class="hero__actions">
        <a class="button button--primary" href="#features">{c.primary}</a>
        <a class="button" href="#app">{c.secondary}</a>
      </p>

      <ul class="hero__promises" role="list">
        {
          c.promises.map((promise) => (
            <li>
              <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                <path d="m5 10.5 3.2 3.2L15 7" />
              </svg>
              {promise}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__visual">
      <div class="hero__phone">
        <img
          src={`${base}/screens/home.webp`}
          alt={c.imageAlt}
          width="300"
          height="608"
          fetchpriority="high"
        />
      </div>
      <div class="note note--warning" aria-hidden="true">
        <span class="note__icon">!</span>
        <span>
          <strong>{c.noteWarning.name}</strong>
          <span>{c.noteWarning.detail}</span>
        </span>
      </div>
      <div class="note note--success" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="18" height="18"><path d="m5 10.5 3.2 3.2L15 7"></path></svg>
        <span>
          <strong>{c.noteSuccess.name}</strong>
          <span>{c.noteSuccess.detail}</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    padding-block: clamp(40px, 6vw, 88px) var(--site-gap);
    background: var(--hm-background);
  }

  .hero__grid {
    display: grid;
    gap: clamp(32px, 5vw, 56px) clamp(32px, 6vw, 80px);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: 1fr minmax(300px, 0.8fr);
    }

    .hero__title {
      grid-column: 1 / -1;
    }

    .hero__copy {
      padding-top: var(--hm-space-section);
    }
  }

  .hero__title {
    font-size: var(--site-display);
    line-height: 0.98;
    font-weight: var(--hm-type-display-weight);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .hero__copy {
    display: grid;
    gap: var(--hm-space-section);
    justify-items: start;
  }

  .hero__lead {
    max-width: 30rem;
    font-size: var(--site-title);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .hero__lead strong {
    color: var(--hm-primary);
    font-weight: var(--hm-type-title-weight);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hm-space-component);
  }

  .hero__promises {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hm-space-inline) var(--hm-space-section);
    font-size: var(--site-small);
  }

  .hero__promises li {
    display: inline-flex;
    align-items: center;
    gap: var(--hm-space-inline);
  }

  .hero__promises svg,
  .note svg {
    fill: none;
    stroke: var(--hm-success);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---- the phone and its notes ---- */

  .hero__visual {
    position: relative;
    justify-self: center;
    inline-size: min(100%, 340px);
  }

  .hero__phone {
    position: relative;
    overflow: hidden;
    border: 10px solid var(--hm-text-primary);
    border-radius: 50px;
    background: var(--hm-surface);
  }

  .hero__phone img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .note {
    position: absolute;
    display: flex;
    align-items: center;
    gap: var(--hm-space-inline);
    padding: var(--hm-space-component) var(--hm-space-card) var(--hm-space-component)
      var(--hm-space-component);
    border-radius: var(--hm-radius-card);
    background: var(--hm-surface);
    font-size: var(--site-small);
    line-height: 1.3;
    white-space: nowrap;
  }

  .note > span:last-child {
    display: grid;
    color: var(--hm-text-secondary);
  }

  .note strong {
    color: var(--hm-text-primary);
  }

  .note__icon {
    display: grid;
    place-items: center;
    inline-size: 26px;
    block-size: 26px;
    border-radius: 50%;
    background: var(--hm-warning-subtle);
    color: var(--hm-on-warning-subtle);
    font-weight: var(--hm-type-title-weight);
  }

  .note--success svg {
    box-sizing: content-box;
    padding: 4px;
    border-radius: 50%;
    background: var(--hm-success-subtle);
  }

  .note--warning {
    top: 20%;
    left: -30%;
  }

  .note--success {
    bottom: 16%;
    right: -26%;
  }

  /* Narrow screens: keep the notes inside the page instead of hanging off the edge. */
  @media (max-width: 40rem) {
    .note--warning {
      left: 0;
    }

    .note--success {
      right: 0;
    }
  }

  /* The first screen arrives in order: the promise, then what it means, then the phone and its
     two notes. Transform and opacity only; nothing waits on a script. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__title,
    .hero__lead,
    .hero__actions,
    .hero__promises,
    .hero__phone,
    .note {
      animation: hero-rise 700ms var(--hm-ease-out) both;
    }

    .hero__lead {
      animation-delay: 80ms;
    }

    .hero__actions {
      animation-delay: 160ms;
    }

    .hero__promises {
      animation-delay: 240ms;
    }

    .hero__phone {
      animation-delay: 200ms;
    }

    .note--warning {
      animation-delay: 520ms;
    }

    .note--success {
      animation-delay: 680ms;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
</style>
