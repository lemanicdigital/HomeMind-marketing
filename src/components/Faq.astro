---
import { type Lang, copyFor } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = copyFor(lang).faq;
const items = c.items;
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="shell stack">
    <header class="section__head section__head--center">
      <p class="t-overline">{c.overline}</p>
      <h2 class="t-headline" id="faq-title">{c.title}</h2>
    </header>

    <div class="faq faq--narrow">
      {
        items.map((item) => (
          <details>
            <summary>
              <span class="t-label">{item.q}</span>
              <span class="chev" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="t-secondary measure">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq--narrow {
    max-width: 48rem;
    margin-inline: auto;
  }

  .faq {
    display: grid;
    gap: 0;
    border-block: var(--hm-border-hairline) solid var(--hm-border-subtle);
  }

  details {
    border-bottom: var(--hm-border-hairline) solid var(--hm-border-subtle);
  }

  details:last-child {
    border-bottom: 0;
  }

  summary {
    display: flex;
    gap: var(--hm-space-card);
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    padding: var(--hm-space-card) 0;
    list-style: none;
    min-block-size: var(--hm-touch-target);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chev {
    display: grid;
    place-items: center;
    inline-size: 28px;
    block-size: 28px;
    border-radius: var(--hm-radius-pill);
    background: var(--hm-surface-secondary);
    color: var(--hm-text-secondary);
  }

  details[open] .chev {
    background: var(--hm-primary-subtle);
    color: var(--hm-on-primary-subtle);
  }

  details p {
    padding-bottom: var(--hm-space-card);
  }
</style>
