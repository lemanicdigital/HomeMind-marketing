---
import { type Lang, copyFor } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = copyFor(lang).faq;
/**
 * The questions under their heading. Each answer opens in place (<details>, no script); the
 * questions are filled rows a tone step from the page, with no rules between them.
 */
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="shell faq">
    <header class="section__head faq__head">
      <h2 class="t-headline" id="faq-title">{c.title}</h2>
    </header>

    <div class="faq__list">
      {
        c.items.map((item) => (
          <details>
            <summary>
              <span>{item.q}</span>
              <svg class="faq__chev" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="t-secondary measure">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: clamp(32px, 6vw, 72px) clamp(40px, 8vw, 120px);
  }

  .faq__head {
    margin-bottom: 0;
  }

  .faq__list {
    display: grid;
    gap: var(--hm-space-inline);
    max-width: 52rem;
  }

  details {
    border-radius: var(--hm-radius-card);
    background: var(--hm-surface);
  }

  summary {
    display: flex;
    gap: var(--hm-space-card);
    align-items: center;
    justify-content: space-between;
    min-block-size: 64px;
    padding: var(--hm-space-card) var(--hm-space-section);
    cursor: pointer;
    list-style: none;
    font-size: var(--site-body);
    font-weight: var(--hm-type-title-weight);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--hm-primary);
  }

  .faq__chev {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    transition: transform var(--hm-duration) var(--hm-ease-out);
  }

  details[open] .faq__chev {
    transform: rotate(45deg);
  }

  details p {
    padding: 0 var(--hm-space-section) var(--hm-space-section);
  }
</style>
