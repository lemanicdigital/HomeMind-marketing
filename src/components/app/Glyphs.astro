---
/**
 * The app's glyphs, drawn once per page and reused with <use>: the eight category marks (the same
 * subjects as the app's icons: cube, leaf, cup, snowflake, sparkle, drop, paw, dots) and the few
 * controls the fragments show. Outline strokes on a 24 grid, like Ionicons' outline set.
 */
---

<svg class="glyphs" aria-hidden="true" focusable="false">
  <symbol id="g-pantry" viewBox="0 0 24 24">
    <path d="M12 3 4 7.5v9L12 21l8-4.5v-9L12 3Zm-8 4.5L12 12l8-4.5M12 12v9"></path>
  </symbol>
  <symbol id="g-fresh" viewBox="0 0 24 24">
    <path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14H5Zm0 0 8-8"></path>
  </symbol>
  <symbol id="g-beverages" viewBox="0 0 24 24">
    <path d="M5 8h11v6a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V8Zm11 1h1.5a2.5 2.5 0 0 1 0 5H16M8 3v2m3-2v2"></path>
  </symbol>
  <symbol id="g-frozen" viewBox="0 0 24 24">
    <path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9M9.5 4.5 12 7l2.5-2.5m-5 15L12 17l2.5 2.5"></path>
  </symbol>
  <symbol id="g-cleaning" viewBox="0 0 24 24">
    <path d="M10 4c.6 3.6 2.4 5.4 6 6-3.6.6-5.4 2.4-6 6-.6-3.6-2.4-5.4-6-6 3.6-.6 5.4-2.4 6-6Zm8 10c.3 1.5 1 2.2 2.5 2.5-1.5.3-2.2 1-2.5 2.5-.3-1.5-1-2.2-2.5-2.5 1.5-.3 2.2-1 2.5-2.5Z"></path>
  </symbol>
  <symbol id="g-bathroom" viewBox="0 0 24 24">
    <path d="M12 3.5c3.5 4.4 6 7.8 6 10.8a6 6 0 0 1-12 0c0-3 2.5-6.4 6-10.8Z"></path>
  </symbol>
  <symbol id="g-pet" viewBox="0 0 24 24">
    <path d="M8 20c-2.5 0-3.5-2-2.5-4 1.5-2.8 3.8-4.5 6.5-4.5s5 1.7 6.5 4.5c1 2 0 4-2.5 4-1.6 0-2.4-.8-4-.8s-2.4.8-4 .8ZM6 10.5a1.8 2.2 0 1 0 0 .01M18 10.5a1.8 2.2 0 1 0 0 .01M9.5 6.5a1.8 2.2 0 1 0 0 .01M14.5 6.5a1.8 2.2 0 1 0 0 .01"></path>
  </symbol>
  <symbol id="g-other" viewBox="0 0 24 24">
    <path d="M6 12h.01M12 12h.01M18 12h.01"></path>
  </symbol>
  <symbol id="g-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></symbol>
  <symbol id="g-gear" viewBox="0 0 24 24">
    <path d="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm7.4 4.5-1.6.9a6 6 0 0 1-.9 1.6l.3 1.8-1.9 1.1-1.4-1.2a6 6 0 0 1-1.9.3l-1 1.5H8.8l-.7-1.7a6 6 0 0 1-1.6-.9l-1.8.3-1.1-1.9 1.2-1.4a6 6 0 0 1 0-1.8L3.6 9.7l1.1-1.9 1.8.3a6 6 0 0 1 1.6-.9L8.8 5.5h2.2l1 1.5a6 6 0 0 1 1.9.3l1.4-1.2 1.9 1.1-.3 1.8a6 6 0 0 1 .9 1.6l1.6.9v2Z"></path>
  </symbol>
  <symbol id="g-chevron" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"></path></symbol>
  <symbol id="g-check" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"></path></symbol>
  <symbol id="g-home" viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V20h-5v-6H9v6H4v-9.5Z"></path></symbol>
  <symbol id="g-list" viewBox="0 0 24 24"><path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01"></path></symbol>
  <symbol id="g-pot" viewBox="0 0 24 24"><path d="M4 10h16v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5v-5Zm-2 0h20M9 6.5c0-1 .8-1.5 1.5-1.5h3c.7 0 1.5.5 1.5 1.5"></path></symbol>
  <symbol id="g-cart" viewBox="0 0 24 24"><path d="M3 4h2.5l2 11h10.5l2-8H6.4M9 20h.01M17 20h.01"></path></symbol>
</svg>

<style>
  .glyphs {
    position: absolute;
    inline-size: 0;
    block-size: 0;
    overflow: hidden;
  }
</style>
