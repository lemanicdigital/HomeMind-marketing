---
import { type Lang, copyFor } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = copyFor(lang).screens;
/**
 * Real screenshots from the app, taken on an iPhone with the development "sample kitchen" loaded.
 * Images come from scripts/screens.py: cropped below the status bar, 600 px wide (2x the size
 * shown here), WebP. Four across on a desk, two by two on a phone: nothing is cut at the edge.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const files = ['home', 'inventory', 'item', 'shopping'];
const screens = c.items.map((item, index) => ({ ...item, file: files[index] }));
---

<section class="section section--tinted" id="app" aria-labelledby="app-title">
  <div class="shell">
    <header class="section__head">
      <h2 class="t-headline" id="app-title">{c.title}</h2>
      <p class="t-lead">{c.lead}</p>
    </header>

    <ul class="screens" role="list">
      {
        screens.map((screen) => (
          <li class="screens__item">
            <figure class="screens__figure">
              <div class="screens__phone">
                <img
                  src={`${base}/screens/${screen.file}.webp`}
                  alt={screen.alt}
                  width="300"
                  height="608"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="screens__caption">
                <span class="t-card-title">{screen.title}</span>
                <span class="t-secondary">{screen.body}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .screens {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(32px, 4vw, 48px) var(--hm-space-screen-gutter);
  }

  @media (min-width: 48rem) {
    .screens {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .screens__figure {
    display: grid;
    gap: var(--hm-space-component);
    margin: 0;
  }

  .screens__phone {
    overflow: hidden;
    border: 6px solid var(--hm-text-primary);
    border-radius: 34px;
    background: var(--hm-surface);
  }

  .screens__phone img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .screens__caption {
    display: grid;
    gap: var(--hm-space-inline);
  }

  /* Two across on a phone leaves short lines; the caption steps down to the small size there. */
  @media (max-width: 48rem) {
    .screens__caption .t-secondary {
      font-size: var(--site-small);
    }
  }
</style>
