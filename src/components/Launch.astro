---
import Logo from './ui/Logo.astro';
import { type Lang, copyFor } from '../i18n';

/**
 * The hero again, turned over: there it is a sky with a blueberry stage, here it is all blueberry.
 * There is nothing to download yet, so the one action is honest about it and leads to the answers.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = copyFor(lang).launch;
---

<section class="launch field field--berry" id="launch" aria-labelledby="launch-title">
  <div class="shell grid launch__grid">
    <div class="launch__mark rise">
      <Logo size={120} />
    </div>
    <h2 class="t-giant launch__title rise" id="launch-title">{c.title}</h2>
    <div class="launch__text stack stack--tight rise rise--2">
      <p class="t-lead launch__body">{c.body}</p>
      <p>
        <a class="button button--primary" href="#faq">
          {c.action}
          <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .launch {
    display: grid;
    align-items: end;
  }

  .launch__grid {
    row-gap: clamp(32px, 4vw, 56px);
    align-items: end;
  }

  .launch__mark {
    grid-column: 1 / -1;
  }

  .launch__title {
    grid-column: 1 / span 8;
  }

  .launch__body {
    max-inline-size: 40ch;
  }

  .launch__text {
    grid-column: 9 / -1;
    align-items: flex-start;
  }

  @media (max-width: 960px) {
    .launch__title,
    .launch__text {
      grid-column: 1 / -1;
    }
  }
</style>
