---
import Logo from './ui/Logo.astro';

import { type Lang, copyFor } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = copyFor(lang).launch;
---

<section class="launch" id="launch" aria-labelledby="launch-title">
  <div class="shell">
    <div class="launch__panel">
      <Logo size={64} />
      <h2 class="t-headline" id="launch-title">{c.title}</h2>
      <p class="launch__body">{c.body}</p>
      <p class="launch__actions">
        <a class="button button--primary" href="#faq">{c.action}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .launch {
    padding-block: 0 clamp(48px, 8vw, 96px);
  }

  .launch__panel {
    display: grid;
    gap: var(--hm-space-card);
    justify-items: center;
    padding: clamp(40px, 7vw, 72px) var(--hm-space-card);
    border-radius: var(--hm-radius-sheet);
    background: var(--hm-primary-subtle);
    color: var(--hm-on-primary-subtle);
    text-align: center;
  }

  .launch__panel :global(.logo) {
    border-radius: 14px;
  }

  .launch__body {
    max-width: 36rem;
    font-size: clamp(16px, 2.2vw, 19px);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .launch__actions {
    margin-top: var(--hm-space-inline);
  }
</style>
