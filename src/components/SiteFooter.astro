---
import Logo from './ui/Logo.astro';
import { type Lang, copyFor, home, page } from '../i18n';

/**
 * The footer as a row of tiles, like the app's Home: the name on ink, where it is made on saffron,
 * and the links in three plain tiles.
 */
interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = copyFor(lang).footer;
const year = new Date().getFullYear();
// Every link names its page: the footer is on /privacy/ and /support/ too.
const columns = [
  {
    title: c.product,
    links: [
      { href: home(lang, '#day'), label: c.features },
      { href: home(lang, '#app'), label: c.screens },
      { href: home(lang, '#how'), label: c.how },
    ],
  },
  {
    title: c.help,
    links: [
      { href: page(lang, 'support/'), label: c.support },
      { href: home(lang, '#faq'), label: c.faq },
      { href: home(lang, '#launch'), label: c.availability },
    ],
  },
  {
    title: c.legal,
    links: [
      { href: page(lang, 'privacy/'), label: c.policy },
      { href: home(lang, '#privacy'), label: c.promise },
    ],
  },
];
---

<footer class="foot">
  <div class="shell foot__tiles">
    <div class="tile tile--ink">
      <p class="foot__name"><Logo size={40} /> HomeMind</p>
      <p>{c.tagline}</p>
    </div>
    <div class="tile tile--saffron">
      <p class="t-title">{c.place}</p>
    </div>
    {
      columns.map((column) => (
        <nav class="tile" aria-label={column.title}>
          <p class="t-title">{column.title}</p>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="shell">
    <p class="t-caption foot__rights">© {year} HomeMind. {c.rights}</p>
  </div>
</footer>

<style>
  .foot {
    padding-block: var(--tile-gap) 32px;
    background: var(--hm-background);
  }

  .foot__tiles {
    display: grid;
    grid-template-columns: 4fr 3fr repeat(3, 2fr);
    gap: var(--tile-gap);
  }

  .tile {
    display: grid;
    align-content: space-between;
    gap: 32px;
    min-block-size: 260px;
    padding: clamp(20px, 2.4vw, 32px);
    border-radius: var(--tile-radius);
    background: var(--hm-surface);
  }

  .tile--ink {
    background: var(--hm-text-primary);
    color: var(--hm-text-inverse);
  }

  .tile--saffron {
    background: var(--hm-accent);
    color: var(--hm-on-accent);
  }

  .foot__name {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: clamp(28px, 2.6vw, 40px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .tile ul {
    display: grid;
    gap: 4px;
  }

  .tile a {
    display: inline-flex;
    align-items: center;
    min-block-size: 36px;
    text-decoration: none;
  }

  .tile a:hover {
    text-decoration: underline;
  }

  .foot__rights {
    padding-block-start: 24px;
  }

  @media (max-width: 1100px) {
    .foot__tiles {
      grid-template-columns: repeat(6, 1fr);
    }

    .tile--ink,
    .tile--saffron {
      grid-column: span 3;
    }

    .tile:not(.tile--ink, .tile--saffron) {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .foot__tiles {
      grid-template-columns: 1fr;
    }

    .tile--ink,
    .tile--saffron,
    .tile:not(.tile--ink, .tile--saffron) {
      grid-column: auto;
      min-block-size: 0;
    }
  }
</style>
