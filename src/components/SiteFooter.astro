---
import Logo from './ui/Logo.astro';
import { type Lang, copyFor, home, page } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = copyFor(lang).footer;
const year = new Date().getFullYear();
// Every link names its page: the footer is on /privacy/ and /support/ too.
const columns = [
  {
    title: c.product,
    links: [
      { href: home(lang, '#features'), label: c.features },
      { href: home(lang, '#how'), label: c.how },
      { href: home(lang, '#app'), label: c.screens },
    ],
  },
  {
    title: c.help,
    links: [
      { href: page(lang, 'support/'), label: c.support },
      { href: home(lang, '#faq'), label: c.faq },
      { href: home(lang, '#launch'), label: c.availability },
    ],
  },
  {
    title: c.legal,
    links: [
      { href: page(lang, 'privacy/'), label: c.policy },
      { href: home(lang, '#privacy'), label: c.promise },
    ],
  },
];
---

<footer class="foot">
  <div class="shell foot__grid">
    <div class="foot__brand">
      <p class="foot__name"><Logo size={28} /> HomeMind</p>
      <p class="t-secondary">{c.tagline}</p>
    </div>
    {
      columns.map((column) => (
        <nav class="foot__column" aria-label={column.title}>
          <p class="t-overline">{column.title}</p>
          <ul role="list">
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="shell foot__base">
    <p class="t-caption">© {year} HomeMind. {c.rights}</p>
  </div>
</footer>

<style>
  .foot {
    padding-block: var(--hm-space-section) var(--hm-space-card);
    background: var(--hm-surface-secondary);
    border-top: var(--hm-border-hairline) solid var(--hm-border-subtle);
  }

  .foot__grid {
    display: grid;
    gap: var(--hm-space-section);
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }

  @media (min-width: 60rem) {
    .foot__grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }

  .foot__brand {
    display: grid;
    gap: var(--hm-space-inline);
    align-content: start;
    max-width: 22rem;
  }

  .foot__name {
    display: inline-flex;
    align-items: center;
    gap: var(--hm-space-inline);
    font-size: var(--hm-type-section-title-size);
    font-weight: var(--hm-type-title-weight);
    letter-spacing: -0.02em;
  }

  /* German compounds ("Datenschutzversprechen") are wider than a phone's column: let the column
     shrink below its longest word, and break that word at a syllable in the page's language. */
  .foot__column {
    display: grid;
    gap: var(--hm-space-component);
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    min-width: 0;
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .foot__column ul {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--hm-space-inline);
  }

  .foot__column a {
    color: var(--hm-text-secondary);
    font-size: var(--hm-type-body-secondary-size);
    text-decoration: none;
  }

  .foot__column a:hover {
    color: var(--hm-text-primary);
    text-decoration: underline;
  }

  .foot__base {
    margin-top: var(--hm-space-section);
    padding-top: var(--hm-space-card);
    border-top: var(--hm-border-hairline) solid var(--hm-border-subtle);
  }

  /* On a tinted footer, tertiary text drops below 4.5:1; use the secondary role instead. */
  .foot__base .t-caption {
    color: var(--hm-text-secondary);
  }
</style>
