---
import { type Lang, copyFor } from '../i18n';

/**
 * One plan, said as one sentence, with the price on saffron, the app's Add colour. Below it, what
 * stays free and what the plan adds, matching the app (HomeMind-IOS: PlanScreen) and the server
 * (HomeMind-backend: domain/plan.ts). The App Store shows each country its own price, which the
 * note says rather than listing.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = copyFor(lang).pricing;
const check = 'm5 12.5 4.5 4.5L19 7.5';
---

<section class="pricing field field--clear" id="pricing" aria-labelledby="pricing-title">
  <div class="shell stack">
    <h2 class="t-display pricing__title" id="pricing-title">{c.title}</h2>
    <p class="pricing__sentence rise">
      {c.sentence.before}<span class="pricing__price">{c.sentence.price}</span>{c.sentence.after}
    </p>

    <div class="pricing__plans">
      <div class="plan" aria-labelledby="plan-free">
        <p class="plan__head">
          <span class="t-title" id="plan-free">{c.free.name}</span>
          <span class="plan__amount">{c.free.price}</span>
        </p>
        <p>{c.free.tagline}</p>
        <ul class="plan__list">
          {
            c.free.items.map((line) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={check} /></svg>
                {line}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="plan plan--household" aria-labelledby="plan-household">
        <p class="plan__head">
          <span class="t-title" id="plan-household">{c.household.name}</span>
          <span class="plan__amount">{c.household.price} <span class="plan__per">{c.household.per}</span></span>
        </p>
        <p>{c.household.badge}. {c.household.tagline}</p>
        <ul class="plan__list">
          {
            [c.household.everything, ...c.household.items].map((line) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={check} /></svg>
                {line}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="pricing__note measure">{c.lead} {c.note}</p>
  </div>
</section>

<style>
  .pricing {
    min-block-size: auto;
  }

  .pricing__title {
    max-inline-size: 18ch;
  }

  /* The plan as a sentence: the price is the one word that gets a block of colour. */
  .pricing__sentence {
    max-inline-size: 38ch;
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.5;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .pricing__price {
    /* The price is set at twice the sentence, so it reads first and the sentence explains it. */
    display: inline-block;
    margin-block: 0.08em;
    padding: 0 0.18em;
    border-radius: 0.16em;
    font-size: 2em;
    line-height: 1.1;
    vertical-align: -0.08em;
    background: var(--hm-accent);
    color: var(--hm-on-accent);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .pricing__plans {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--tile-gap);
  }

  .plan {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--tile-radius);
    background: var(--hm-surface);
  }

  .plan--household {
    background: var(--hm-primary);
    color: var(--hm-on-primary);
  }

  .plan__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
  }

  .plan__amount {
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .plan__per {
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0;
  }

  .plan__list {
    display: grid;
    gap: 10px;
    margin-block-start: 8px;
  }

  .plan__list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .plan__list svg {
    flex: none;
    inline-size: 22px;
    block-size: 22px;
    margin-block-start: 3px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pricing__note {
    font-size: var(--fs-small);
  }

  @media (max-width: 860px) {
    .pricing__plans {
      grid-template-columns: 1fr;
    }
  }
</style>
