---
import { type Lang, copyFor } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = copyFor(lang).pricing;
/**
 * The two plans, matching the app (HomeMind-IOS: PlanScreen) and the server
 * (HomeMind-backend: domain/plan.ts, PLAN_PRODUCTS). Prices are App Store Connect's euro tier; the
 * App Store shows each country its own, which this page says rather than listing. The plans are
 * filled surfaces, one tone step apart, with the price at headline size.
 */
const check = 'm5 10.5 3.2 3.2L15 7';
---

<section class="section" id="pricing" aria-labelledby="pricing-title">
  <div class="shell">
    <header class="section__head">
      <h2 class="t-headline" id="pricing-title">{c.title}</h2>
      <p class="t-lead">{c.lead}</p>
    </header>

    <div class="plans">
      <article class="plan" aria-labelledby="plan-free">
        <h3 class="t-section" id="plan-free">{c.free.name}</h3>
        <p class="plan__price"><span class="t-numeric">{c.free.price}</span></p>
        <p class="t-secondary">{c.free.tagline}</p>
        <ul class="list" role="list">
          {
            c.free.items.map((line) => (
              <li>
                <svg class="list__mark" viewBox="0 0 20 20" aria-hidden="true">
                  <path d={check} />
                </svg>
                <span class="t-body">{line}</span>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="plan plan--featured" aria-labelledby="plan-household">
        <h3 class="t-section" id="plan-household">{c.household.name}</h3>
        <p class="plan__price">
          <span class="t-numeric">{c.household.price}</span>
          <span class="t-secondary">{c.household.per}</span>
        </p>
        <p class="plan__trial">{c.household.badge}</p>
        <p class="t-secondary">{c.household.tagline}</p>
        <ul class="list" role="list">
          {
            [c.household.everything, ...c.household.items].map((line) => (
              <li>
                <svg class="list__mark" viewBox="0 0 20 20" aria-hidden="true">
                  <path d={check} />
                </svg>
                <span class="t-body">{line}</span>
              </li>
            ))
          }
        </ul>
        <p class="t-caption plans__note">{c.note}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .plans {
    display: grid;
    gap: var(--hm-space-screen-gutter);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }

  .plan {
    display: grid;
    gap: var(--hm-space-card);
    align-content: start;
    padding: clamp(24px, 4vw, 48px);
    border-radius: var(--hm-radius-sheet);
    background: var(--hm-surface);
  }

  .plan--featured {
    background: var(--hm-primary-subtle);
  }

  .plan__price {
    display: flex;
    gap: var(--hm-space-inline);
    align-items: baseline;
    margin-block: var(--hm-space-inline);
  }

  .plan__trial {
    margin-top: calc(-1 * var(--hm-space-inline));
    color: var(--hm-primary);
    font-weight: var(--hm-type-title-weight);
  }

  .plans__note {
    margin-top: var(--hm-space-inline);
  }
</style>
