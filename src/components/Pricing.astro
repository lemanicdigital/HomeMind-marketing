---
import { type Lang, copyFor } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = copyFor(lang).pricing;
/**
 * The two plans, matching the app (HomeMind-IOS: PlanScreen) and the server
 * (HomeMind-backend: domain/plan.ts, PLAN_PRODUCTS). Prices are App Store Connect's euro tier; the
 * App Store shows each country its own, which this page says rather than listing.
 */
---

<section class="section" id="pricing" aria-labelledby="pricing-title">
  <div class="shell">
    <header class="section__head section__head--center">
      <p class="t-overline">{c.overline}</p>
      <h2 class="t-headline" id="pricing-title">{c.title}</h2>
      <p class="t-lead measure">{c.lead}</p>
    </header>

    <div class="plans">
      <article class="plan" aria-labelledby="plan-free">
        <h3 class="t-section" id="plan-free">{c.free.name}</h3>
        <p class="plan__price"><span class="t-numeric">{c.free.price}</span></p>
        <p class="t-secondary">{c.free.tagline}</p>
        <ul class="list" role="list">
          {
            c.free.items.map((line) => (
              <li>
                <span class="list__mark" aria-hidden="true">
                  ✓
                </span>
                <span class="t-body">{line}</span>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="plan plan--featured" aria-labelledby="plan-household">
        <div class="row">
          <h3 class="t-section" id="plan-household">{c.household.name}</h3>
          <span class="badge badge--primary">{c.household.badge}</span>
        </div>
        <p class="plan__price">
          <span class="t-numeric">{c.household.price}</span>
          <span class="t-secondary">{c.household.per}</span>
        </p>
        <p class="t-secondary">{c.household.tagline}</p>
        <ul class="list" role="list">
          <li>
            <span class="list__mark" aria-hidden="true">✓</span>
            <span class="t-body">{c.household.everything}</span>
          </li>
          {
            c.household.items.map((line) => (
              <li>
                <span class="list__mark" aria-hidden="true">
                  ✓
                </span>
                <span class="t-body">{line}</span>
              </li>
            ))
          }
        </ul>
      </article>
    </div>

    <p class="t-caption plans__note measure">{c.note}</p>
  </div>
</section>

<style>
  .plans {
    display: grid;
    gap: var(--hm-space-screen-gutter);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    max-inline-size: 52rem;
    margin-inline: auto;
  }

  .plan {
    display: grid;
    gap: var(--hm-space-component);
    align-content: start;
    padding: var(--hm-space-section) var(--hm-space-card);
    border: var(--hm-border-hairline) solid var(--hm-border-subtle);
    border-radius: var(--hm-radius-sheet);
    background: var(--hm-surface);
  }

  .plan--featured {
    border-color: var(--hm-primary);
    box-shadow: inset 0 0 0 1px var(--hm-primary);
  }

  .plan__price {
    display: flex;
    gap: var(--hm-space-inline);
    align-items: baseline;
  }

  .plans__note {
    margin: var(--hm-space-section) auto 0;
    text-align: center;
  }
</style>
