---
/**
 * The app icon's mark, the sky window: an arched window (home) whose round head is the sky, with the
 * sun rising on its sill. Same geometry as brand/homesky-symbol.svg, drawn here from theme roles so
 * it follows dark mode.
 */
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg class="logo" viewBox="0 0 256 256" width={size} height={size} aria-hidden="true">
  <rect class="logo__tile" width="256" height="256" rx="56"></rect>
  <g transform="translate(5.12 5.12) scale(0.96)">
    <path
      class="logo__frame"
      fill-rule="evenodd"
      d="M56 116A72 72 0 0 1 200 116V200A12 12 0 0 1 188 212H68A12 12 0 0 1 56 200ZM80 188H176V116A48 48 0 0 0 80 116Z"
    ></path>
    <path class="logo__sun" d="M94 188A34 34 0 0 1 162 188Z"></path>
  </g>
</svg>

<style>
  .logo {
    flex: none;
  }

  .logo__tile {
    fill: var(--hm-primary);
  }

  .logo__frame {
    fill: var(--hm-on-primary);
  }

  .logo__sun {
    fill: var(--hm-accent);
  }

  /* Dark mode matches the dark app icon: a night tile, the frame in the light primary. */
  @media (prefers-color-scheme: dark) {
    .logo__tile {
      fill: var(--hm-primary-subtle);
    }

    .logo__frame {
      fill: var(--hm-primary);
    }
  }
</style>
