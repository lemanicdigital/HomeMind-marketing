---
import { type Lang, copyFor } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = copyFor(lang).how;
/**
 * The three habits, on a whole field of the brand's green: the one place the page changes colour.
 * The order lives in the <ol> and in reading order, not in numbered circles.
 */
---

<section class="section how" id="how" aria-labelledby="how-title">
  <div class="shell">
    <header class="section__head">
      <h2 class="t-headline" id="how-title">{c.title}</h2>
    </header>

    <ol class="how__steps">
      {
        c.steps.map((step) => (
          <li>
            <h3 class="how__title">{step.title}</h3>
            <p class="how__body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how {
    background: var(--hm-primary);
    color: var(--hm-on-primary);
  }

  .how__steps {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }

  .how__steps li {
    display: grid;
    gap: var(--hm-space-component);
    align-content: start;
  }

  .how__title {
    font-size: clamp(24px, 2.6vw, 30px);
    line-height: 1.2;
    font-weight: var(--hm-type-display-weight);
    letter-spacing: -0.02em;
  }

  .how__body {
    font-size: var(--site-body);
    line-height: 1.55;
  }
</style>
