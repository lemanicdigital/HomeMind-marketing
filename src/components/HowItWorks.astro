---
const steps = [
  {
    title: 'Add what you have',
    body: 'Type it or scan the barcode. A count and a date are optional; HomeMind is honest about what it does not know.',
  },
  {
    title: 'Use things up',
    body: 'Tap “used one” as you go. HomeMind learns how fast your household gets through each thing.',
  },
  {
    title: 'Shop with a list you trust',
    body: 'What ran out is already on it, what runs out next is suggested, and nothing in the cupboard is bought twice.',
  },
];
---

<section class="section section--tinted" id="how" aria-labelledby="how-title">
  <div class="shell">
    <header class="section__head section__head--center">
      <p class="t-overline">How it works</p>
      <h2 class="t-headline" id="how-title">Three habits, no spreadsheet</h2>
    </header>

    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step">
            <span class="step__number" aria-hidden="true">
              {index + 1}
            </span>
            <h3 class="t-card-title">{step.title}</h3>
            <p class="t-secondary">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: var(--hm-space-section);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    gap: var(--hm-space-inline);
    align-content: start;
    justify-items: center;
    text-align: center;
  }

  .step__number {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    margin-bottom: var(--hm-space-inline);
    border-radius: 50%;
    background: var(--hm-primary);
    color: var(--hm-on-primary);
    font-size: var(--hm-type-card-title-size);
    font-weight: var(--hm-type-title-weight);
  }
</style>
