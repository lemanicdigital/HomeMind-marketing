---
import Row from './app/Row.astro';
import { type Lang, copyFor } from '../i18n';

/**
 * The three habits as three tiles that grow, left to right, the way a household's record does:
 * a few things added, then used, then a list that writes itself. Each tile holds the piece of the
 * app that habit uses. The order is real, so it lives in an <ol>.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { how, app } = copyFor(lang);
const shelf = [app.shelf[0], app.shelf[3], app.shelf[5]];
---

<section class="how field field--surface" id="how" aria-labelledby="how-title">
  <div class="shell stack">
    <h2 class="t-display how__title" id="how-title">{how.title}</h2>
    <ol class="how__tiles">
      <li class="how__tile how__tile--1 grow">
        <div class="stack stack--tight">
          <h3 class="t-statement">{how.steps[0].title}</h3>
          <p>{how.steps[0].body}</p>
        </div>
        <div class="ui-piece" data-ui role="img" aria-label={shelf.map((item) => item.name).join(', ')}>
          <ul class="ui-card ui-card--quiet">
            {shelf.map((item) => <Row {...item} />)}
          </ul>
        </div>
      </li>
      <li class="how__tile how__tile--2 grow">
        <div class="stack stack--tight">
          <h3 class="t-statement">{how.steps[1].title}</h3>
          <p>{how.steps[1].body}</p>
        </div>
        <div class="ui-piece" data-ui role="img" aria-label={`${app.use.name}, ${app.use.qty}: ${app.usedOne}`}>
          <ul class="ui-card ui-card--quiet">
            <Row name={app.use.name} qty={app.use.qty} kind="beverages" />
          </ul>
          <span class="ui-used"><svg viewBox="0 0 24 24"><use href="#g-check" /></svg>{app.usedOne}</span>
        </div>
      </li>
      <li class="how__tile how__tile--3 grow">
        <div class="stack stack--tight">
          <h3 class="t-statement">{how.steps[2].title}</h3>
          <p>{how.steps[2].body}</p>
        </div>
        <div class="ui-piece" data-ui role="img" aria-label={app.buy.map((item) => item.name).join(', ')}>
          <p class="ui-section"><span>{app.toBuy}</span><span class="ui-count">{app.buy.length}</span></p>
          <ul class="ui-card ui-card--quiet">
            {
              app.buy.map((item) => (
                <li class="ui-row">
                  <span class="ui-box" />
                  <span class="ui-row__text">
                    <span class="ui-row__name">{item.name}</span>
                    {item.reason ? <span class="ui-row__detail">{item.reason}</span> : null}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .how {
    min-block-size: auto;
  }

  .how__title {
    max-inline-size: 20ch;
  }

  .how__tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: end;
    gap: var(--tile-gap);
  }

  .how__tile {
    display: grid;
    align-content: space-between;
    gap: 32px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--tile-radius);
    background: var(--hm-background);
  }

  /* Each tile a step taller than the last: the record grows as the habits do. */
  .how__tile--1 {
    min-block-size: 440px;
  }

  .how__tile--2 {
    min-block-size: 520px;
    background: var(--hm-sky-day);
  }

  .how__tile--3 {
    min-block-size: 640px;
    background: var(--hm-primary);
    color: var(--hm-on-primary);
  }

  .how__tile .ui-piece {
    inline-size: 100%;
  }

  @media (max-width: 960px) {
    .how__tiles {
      grid-template-columns: 1fr;
    }

    .how__tile--1,
    .how__tile--2,
    .how__tile--3 {
      min-block-size: 0;
    }
  }
</style>
